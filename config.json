{
  "id": "zapgoalswasm",
  "name": "Zap Goals!",
  "short_description": "Create customizable Lightning funding goals with live progress",
  "description": "Invoice-only public Lightning funding goals with local QR codes, verified contribution accounting, fixed calendar periods, manual wallet sweeps, and a JavaScript widget.",
  "description_md": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/description.md",
  "repo": "https://github.com/bitkarrot/zapgoalswasm",
  "version": "0.5.2",
  "min_lnbits_version": "1.6.0",
  "tile": "/ext-assets/zapgoalswasm/assets/icon.png",
  "tags": [
    "Crowdfunding",
    "Lightning",
    "WASM"
  ],
  "contributors": [
    {
      "name": "bitkarrot",
      "uri": "https://github.com/bitkarrot",
      "role": "Creator"
    }
  ],
  "images": [
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/public-goal.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-public-goal.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-choose-zap.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-bolt11.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-edit-goal.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-design-preview.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-fixed-rules.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-history.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/bitkarrot/zapgoalswasm/v0.5.2/screenshots/invoice-only-mobile-invoice.png"
    }
  ],
  "extension_type": "wasm",
  "license": "MIT",
  "wasm": {
    "module": "wasm/module.wasm",
    "wit": "wasm/wit/world.wit",
    "world": "zapgoals",
    "exports": [
      {
        "name": "create-goal",
        "visibility": "authenticated"
      },
      {
        "name": "list-goals",
        "visibility": "authenticated"
      },
      {
        "name": "get-wallets",
        "visibility": "authenticated"
      },
      {
        "name": "update-goal",
        "visibility": "authenticated"
      },
      {
        "name": "delete-goal",
        "visibility": "authenticated"
      },
      {
        "name": "get-public-goal",
        "visibility": "public"
      },
      {
        "name": "create-invoice",
        "visibility": "public"
      },
      {
        "name": "on-invoice-paid",
        "visibility": "event"
      },
      {
        "name": "sweep-goal",
        "visibility": "authenticated"
      },
      {
        "name": "list-periods",
        "visibility": "authenticated"
      },
      {
        "name": "sweep-due",
        "visibility": "authenticated"
      },
      {
        "name": "invoice-status",
        "visibility": "public"
      }
    ]
  },
  "ui_routes": [
    {
      "path": "/zapgoalswasm",
      "entrypoint": "templates/index.html",
      "auth": "user"
    },
    {
      "path": "/zapgoalswasm/public/{goalId}",
      "entrypoint": "templates/public.html",
      "auth": "public"
    }
  ],
  "api_routes": [
    {
      "method": "POST",
      "path": "/goals",
      "export": "create-goal",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/goals",
      "export": "list-goals",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/wallets",
      "export": "get-wallets",
      "auth": "user"
    },
    {
      "method": "PUT",
      "path": "/goals/{goalId}",
      "export": "update-goal",
      "auth": "user",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "DELETE",
      "path": "/goals/{goalId}",
      "export": "delete-goal",
      "auth": "user",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "GET",
      "path": "/goals/{goalId}/public",
      "export": "get-public-goal",
      "auth": "public",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "POST",
      "path": "/goals/{goalId}/invoice",
      "export": "create-invoice",
      "auth": "public",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "POST",
      "path": "/goals/{goalId}/sweep",
      "export": "sweep-goal",
      "auth": "user",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "GET",
      "path": "/goals/{goalId}/periods",
      "export": "list-periods",
      "auth": "user",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    },
    {
      "method": "POST",
      "path": "/recurring/sweep-due",
      "export": "sweep-due",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/goals/{goalId}/payments/{paymentHash}",
      "export": "invoice-status",
      "auth": "public",
      "ownerContext": {
        "table": "goals",
        "idParam": "goalId"
      }
    }
  ],
  "events": {
    "onInvoicePaid": "on-invoice-paid"
  },
  "permissions": [
    {
      "id": "ext.storage.read",
      "description": "Read owned goal storage"
    },
    {
      "id": "ext.storage.read_public",
      "description": "Read public goal fields",
      "policies": [
        {
          "table_name": "goals",
          "public_fields": [
            "id",
            "title",
            "descriptionAbove",
            "descriptionBelow",
            "goalAmount",
            "currentAmount",
            "targetDate",
            "suggestedAmounts",
            "walletMode",
            "backgroundColor",
            "textColor",
            "progressColor",
            "remainderColor",
            "fontName",
            "fontWeight",
            "createdAt",
            "updatedAt",
            "recurring",
            "recurrenceUnit",
            "recurrenceInterval",
            "periodIndex",
            "periodEndDate",
            "archived",
            "accountingVersion",
            "periodStartDate",
            "recurrenceDayOfMonth",
            "rolloverMode",
            "sweepMode"
          ],
          "source_id_field": "id"
        },
        {
          "table_name": "payment_events",
          "public_fields": [
            "id",
            "goalId",
            "verified",
            "amount",
            "issuedAt"
          ],
          "source_id_field": "goalId"
        }
      ]
    },
    {
      "id": "ext.storage.write",
      "description": "Create and update goals"
    },
    {
      "id": "wallet.list",
      "description": "List wallets owned by the user"
    },
    {
      "id": "wallet.create_invoice_public",
      "description": "Create public contribution invoices",
      "policies": [
        {
          "table": "goals",
          "wallet_field": "walletId"
        }
      ]
    },
    {
      "id": "ext.storage.append_public",
      "description": "Record private goal-bound invoice issuances before creating contribution invoices",
      "policies": [
        {
          "table": "invoice_issuances",
          "source_table": "goals",
          "source_id_field": "goalId",
          "allowed_fields": [
            "amount",
            "createdAt"
          ],
          "max_rows_per_source": 10000
        }
      ]
    },
    {
      "id": "wallet.create_invoice",
      "description": "Create internal sweep invoices on the user's target wallet"
    },
    {
      "id": "wallet.pay_invoice",
      "description": "Pay sweep invoices from the goal's receiving wallet"
    }
  ]
}
