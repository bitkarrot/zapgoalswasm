package lnbits:extension;
interface host {
  record storage-get-request { table: string, id: string }
  record storage-get-response { data-json: option<string> }
  storage-get: func(req: storage-get-request) -> storage-get-response;
  record storage-get-public-request { table: string, id: string }
  storage-get-public: func(req: storage-get-public-request) -> storage-get-response;
  record storage-set-request { table: string, data-json: option<string> }
  record storage-set-response { ok: bool }
  storage-set: func(req: storage-set-request) -> storage-set-response;
  record storage-delete-request { table: string, id: string }
  record storage-delete-response { ok: bool }
  storage-delete: func(req: storage-delete-request) -> storage-delete-response;
  record storage-paginated-request { table: string, filters-json: option<string>, search: option<string>, search-fields-json: option<string>, sort-by: option<string>, descending: bool, limit: u32, offset: u32 }
  record storage-paginated-response { rows-json: string, total: u32 }
  storage-get-paginated: func(req: storage-paginated-request) -> storage-paginated-response;
  record create-invoice-public-request { source-id: string, amount: u64, currency: string, memo: string, extra-json: option<string> }
  record create-invoice-response { payment-hash: string, payment-request: string, checking-id: string }
  create-invoice-public: func(req: create-invoice-public-request) -> create-invoice-response;
  record wallet-summary { id: string, name: string, currency: option<string> }
  record list-wallets-response { wallets: list<wallet-summary> }
  list-user-wallets: func() -> list-wallets-response;
  record now-response { timestamp: u64 }
  now: func() -> now-response;
  record random-id-request { prefix: string }
  record random-id-response { id: string }
  random-id: func(req: random-id-request) -> random-id-response;
  record log-request { level: string, message: string }
  record log-response { ok: bool }
  log: func(req: log-request) -> log-response;
}
world zapgoals { import host; export create-goal: func(payload: string) -> string; export list-goals: func(payload: string) -> string; export get-wallets: func(payload: string) -> string; export update-goal: func(payload: string) -> string; export delete-goal: func(payload: string) -> string; export get-public-goal: func(payload: string) -> string; export create-invoice: func(payload: string) -> string; export lnurl-params: func(payload: string) -> string; export lnurl-callback: func(payload: string) -> string; export on-invoice-paid: func(payload: string) -> string; }
